{
  "name": "achamos-imoveis-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "guard:secrets": "node scripts/guards/check-secrets-hardcoded.mjs",
    "guard:env-leak": "node scripts/guards/check-env-leak.mjs",
    "guard:all": "npm run guard:env-leak && npm run guard:secrets",
    "full-check": "npm run guard:all && npm run typecheck"
  },
  "dependencies": {
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
